{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/mangatrans-backend",
          "sidecar": true
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
